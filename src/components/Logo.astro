---
// Brand mark: a two-colour capsule with a bite taken out of one end.
// Same drawing as public/favicon.svg — change both together.
interface Props {
  size?: number;
}

const { size = 34 } = Astro.props;
---

<svg class="logo" viewBox="0 0 40 40" width={size} height={size} aria-hidden="true">
  <defs>
    <mask id="logo-bite">
      <rect width="40" height="40" fill="#fff" />
      <circle cx="31.5" cy="6.5" r="4.6" fill="#000" />
      <circle cx="35.5" cy="11.5" r="3.6" fill="#000" />
      <circle cx="27" cy="3" r="3.4" fill="#000" />
    </mask>
  </defs>
  <g mask="url(#logo-bite)">
    <g transform="rotate(-45 20 20)">
      <rect x="3" y="12" width="34" height="16" rx="8" fill="#292725" />
      <path d="M20 12 H29 a8 8 0 0 1 0 16 H20 Z" fill="#e87532" />
      <rect x="7" y="15" width="8" height="3" rx="1.5" fill="#fff" opacity=".35" />
    </g>
  </g>
</svg>

<style>
.logo {
  flex-shrink: 0;
  transition: rotate 0.2s;
}

/* A small wiggle when you hover the brand */
:global(.brand:hover) .logo {
  rotate: -8deg;
}

@media (prefers-reduced-motion: reduce) {
  .logo {
    transition: none;
  }
}
</style>
