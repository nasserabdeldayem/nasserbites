---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="card">
  <h3>{title}</h3>
  <div class="card-body"><slot /></div>
</div>

<style>
.card {
  padding: 22px 24px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
}

:global(.prose) .card h3 {
  margin: 0 0 8px;
  font-family: var(--font-sans);
  font-size: 19px;
  font-weight: 600;
}

.card-body {
  font-size: 16px;
  line-height: 1.8;
  color: var(--text-muted);
}

.card-body :global(p) {
  margin: 0;
}
</style>
