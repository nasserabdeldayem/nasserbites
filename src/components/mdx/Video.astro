---
// Self-hosted video (a file in /public/videos) that plays inside the post.
// A large play button sits over the cover so it reads clearly as a video.
interface Props {
  src: string;
  poster?: string;
  caption?: string;
  duration?: string; // e.g. "2:49", shown in the label above the player
}

const { src, poster, caption, duration } = Astro.props;
const isAr = Astro.url.pathname.startsWith("/ar");
const label = isAr ? "فيديو" : "Video";
const playLabel = isAr ? "تشغيل الفيديو" : "Play video";
---

<figure class="video">
  <p class="video-label">
    <span class="dot" aria-hidden="true"></span>
    {label}
    {duration && (
      <>
        <span aria-hidden="true">·</span>
        <span class="dur" dir="ltr">{duration}</span>
      </>
    )}
  </p>
  <div class="player">
    <video controls playsinline preload="metadata" poster={poster}>
      <source src={src} type="video/mp4" />
    </video>
    <button type="button" class="play" aria-label={playLabel}>
      <svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor" /></svg>
    </button>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  for (const player of document.querySelectorAll<HTMLElement>(".video .player")) {
    const video = player.querySelector("video");
    const button = player.querySelector<HTMLButtonElement>(".play");
    if (!video || !button) continue;
    button.addEventListener("click", () => video.play());
    video.addEventListener("play", () => (button.hidden = true));
    video.addEventListener("ended", () => (button.hidden = false));
  }
</script>

<style>
.video {
  margin: 30px 0;
}

.video-label {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin: 0 0 12px;
  padding: 5px 14px;
  border-radius: 999px;
  background: var(--text);
  color: var(--bg);
  font: 600 14px/1.5 var(--font-sans);
}

.dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--accent);
}

.player {
  position: relative;
}

video {
  display: block;
  width: 100%;
  aspect-ratio: 16 / 9;
  background: #171514;
  border-radius: 14px;
  box-shadow: 0 12px 30px rgba(41, 39, 37, 0.18);
}

.play {
  position: absolute;
  left: 50%;
  top: 50%;
  translate: -50% -50%;
  display: grid;
  place-items: center;
  width: 84px;
  height: 84px;
  padding: 0 0 0 5px;
  border: 0;
  border-radius: 50%;
  background: var(--accent);
  color: white;
  box-shadow: 0 0 0 10px rgba(232, 117, 50, 0.28), 0 8px 24px rgba(0, 0, 0, 0.35);
  cursor: pointer;
  transition: scale 0.15s;
}

.play:hover,
.play:focus-visible {
  scale: 1.07;
}

.play:focus-visible {
  outline: 3px solid white;
  outline-offset: 4px;
}

figcaption {
  margin-top: 10px;
  font-size: 14px;
  line-height: 1.7;
  color: var(--text-muted);
}

@media (max-width: 600px) {
  .play {
    width: 64px;
    height: 64px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .play {
    transition: none;
  }
}
</style>
