---
import Layout from "./Layout.astro";
import Share from "../components/Share.astro";
import { stages, formatDate, getTranslation, urlOf, type Post } from "../lib/posts";
import { useTranslations, prefixOf } from "../i18n/ui";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, lang, stage, planted, tended, topics, draft } = post.data;
const t = useTranslations(lang);
const isBite = post.collection === "bites";
const backHref = `${prefixOf(lang)}/${post.collection}`;

// Language switch goes to the translation, or to the other language's list if there is none yet
const translation = await getTranslation(post);
const alternate = translation
  ? urlOf(translation)
  : `${prefixOf(lang === "ar" ? "en" : "ar")}/${post.collection}`;
---

<Layout
  title={`${title} — ${t.brand}`}
  description={description}
  lang={lang}
  alternate={alternate}
  image={post.data.image}
  imageAlt={post.data.imageAlt}
  type="article"
>
  <article class="post">
    <a class="back-link" href={backHref}>{isBite ? t.allBites : t.allArticles}</a>

    <p class="eyebrow">
      {isBite ? t.bite : t.article}{topics.length > 0 && ` · ${topics.join(" · ")}`}
      {draft && <span class="draft">{t.draft}</span>}
    </p>

    <h1>{title}</h1>

    <p class="lead">{description}</p>

    <div class="meta-row">
      <dl class="meta">
        <div>
          <dt>{t.stage}</dt>
          <dd>{stages[stage].icon} {t.stages[stage]}</dd>
        </div>
        <div>
          <dt>{t.planted}</dt>
          <dd><time datetime={planted.toISOString()}>{formatDate(planted, lang)}</time></dd>
        </div>
        {tended && (
          <div>
            <dt>{t.tended}</dt>
            <dd><time datetime={tended.toISOString()}>{formatDate(tended, lang)}</time></dd>
          </div>
        )}
      </dl>

      <button type="button" class="share-top" data-share-top>
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 3v12M7 8l5-5 5 5M5 13v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        {t.share}
      </button>
    </div>

    <div class="prose">
      <slot />
    </div>

    <Share title={title} lang={lang} />
  </article>
</Layout>

<style>
.post {
  max-width: var(--prose-width);
  margin: 0 auto;
  padding: 80px 0 120px;
}

.eyebrow {
  margin: 70px 0 25px;
}

.draft {
  margin-inline-start: 10px;
  padding: 2px 8px;
  border: 1px dashed var(--accent);
  border-radius: 3px;
}

h1 {
  font-family: var(--font-serif);
  font-size: clamp(44px, 7vw, 76px);
  line-height: 1;
  font-weight: 500;
  margin: 0 0 35px;
}

.lead {
  font-size: 22px;
  line-height: 1.65;
  color: var(--text-muted);
  margin: 0 0 35px;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin: 0 0 60px;
  padding: 18px 0;
  border-block: 1px solid var(--border);
}

.meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12px 40px;
  margin: 0;
  font-size: 14px;
}

.share-top {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 9px 18px;
  background: var(--accent);
  border: 0;
  border-radius: 999px;
  color: white;
  font: 500 15px/1.4 var(--font-sans);
  cursor: pointer;
}

.share-top:hover,
.share-top:focus-visible {
  filter: brightness(0.95);
}

.meta dt {
  color: var(--text-muted);
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 4px;
}

.meta dd {
  margin: 0;
}

/* Arabic titles: El Messiri, warm but clear in long titles with Latin words like GLP-1 */
:global([lang="ar"]) h1 {
  font-family: "El Messiri", var(--font-serif);
  font-weight: 700;
  line-height: 1.4;
}

:global([lang="ar"]) .meta dt {
  letter-spacing: 0;
  font-size: 13px;
}

@media (max-width: 700px) {
  .post {
    padding: 50px 0 80px;
  }

  .lead {
    font-size: 19px;
  }
}
</style>
