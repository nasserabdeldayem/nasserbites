---
import "../styles/global.css";
import { useTranslations, prefixOf, type Lang } from "../i18n/ui";

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  // Same page in the other language; defaults to swapping the /ar prefix
  alternate?: string;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
const { title = t.brand, description = t.siteDescription } = Astro.props;

const prefix = prefixOf(lang);
const current = Astro.url.pathname;
const otherLang: Lang = lang === "ar" ? "en" : "ar";
const alternate =
  Astro.props.alternate ??
  (lang === "ar" ? current.replace(/^\/ar(?=\/|$)/, "") || "/" : `/ar${current === "/" ? "" : current}`);

const nav = [
  { href: `${prefix}/bites`, label: t.nav.bites },
  { href: `${prefix}/articles`, label: t.nav.articles },
  { href: `${prefix}/garden`, label: t.nav.garden },
  { href: `${prefix}/about`, label: t.nav.about },
];
---

<html lang={lang} dir={lang === "ar" ? "rtl" : "ltr"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <!-- Arabic fonts load on every page; the files only download when Arabic text appears -->
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600&family=Noto+Naskh+Arabic:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <nav>
      <a class="brand" href={prefix || "/"}>{t.brand}</a>

      <div class="nav-links">
        {nav.map((item) => (
          <a href={item.href} aria-current={current.startsWith(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))}
        <a class="lang-switch" href={alternate} hreflang={otherLang} lang={otherLang}>
          {t.switchTo}
        </a>
      </div>
    </nav>

    <main>
      <slot />
    </main>
  </body>
</html>

<style>
nav {
  max-width: var(--page-width);
  margin: 0 auto;
  padding: 30px var(--gutter);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24px;
}

nav a {
  color: var(--text);
  text-decoration: none;
}

.brand {
  font-family: var(--font-serif);
  font-size: 24px;
  font-weight: 600;
  white-space: nowrap;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 28px;
}

.nav-links a {
  font-size: 15px;
}

.nav-links a[aria-current="page"] {
  color: var(--accent);
}

.lang-switch {
  padding: 4px 12px;
  border: 1px solid var(--border);
  border-radius: 999px;
}

.lang-switch:hover {
  border-color: var(--accent);
}

.nav-links a:hover,
.brand:hover {
  color: var(--accent);
}

@media (max-width: 700px) {
  nav {
    align-items: flex-start;
    flex-direction: column;
    gap: 18px;
  }

  .brand {
    font-size: 22px;
  }

  .nav-links {
    flex-wrap: wrap;
    gap: 18px;
  }

  .nav-links a {
    font-size: 14px;
  }
}
</style>
