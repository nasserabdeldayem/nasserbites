---
import Layout from "../../layouts/Layout.astro";
import PostCard from "../../components/PostCard.astro";
import { getListing } from "../../lib/posts";

const posts = await getListing("articles", "en");
---

<Layout title="Articles — Nasser’s Bites">
  <section class="listing">
    <p class="eyebrow">Long reads</p>
    <h1 class="page-title">Articles</h1>
    <p class="page-intro">
      Longer explorations, for the ideas that need more room than a bite.
    </p>

    <div class="grid">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
    {posts.length === 0 && <p class="page-intro">The first articles are still being written.</p>}
  </section>
</Layout>

<style>
.listing {
  padding: 80px 0 120px;
}

.page-intro {
  max-width: 600px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 24px;
  margin-top: 60px;
}
</style>
