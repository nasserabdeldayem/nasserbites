---
import Layout from "../../layouts/Layout.astro";
import PostCard from "../../components/PostCard.astro";
import { getListing } from "../../lib/posts";

const posts = await getListing("bites", "en");
---

<Layout title="Bites — Nasser’s Bites">
  <section class="listing">
    <p class="eyebrow">Short notes</p>
    <h1 class="page-title">Bites</h1>
    <p class="page-intro">
      Small, focused explanations — one question, one idea at a time.
    </p>

    <div class="grid">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
    {posts.length === 0 && <p class="page-intro">The first bites are still cooking.</p>}
  </section>
</Layout>

<style>
.listing {
  padding: 80px 0 120px;
}

.page-intro {
  max-width: 600px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 24px;
  margin-top: 60px;
}
</style>
