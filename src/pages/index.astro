---
import Layout from "../layouts/Layout.astro";
import PostCard from "../components/PostCard.astro";
import { getAllPosts } from "../lib/posts";

const recent = (await getAllPosts("en")).slice(0, 6);
---

<Layout>
  <section class="hero">
    <p class="eyebrow">A pharmacist's digital notebook</p>

    <h1>
      Small bites.<br />
      Big ideas.
    </h1>

    <p class="intro">
      Notes on pharmacy, medicine, research,
      and the things I find worth knowing.
    </p>

    <a class="button" href="/garden">Explore the garden →</a>
  </section>

  <section class="recent">
    <div class="section-heading">
      <p class="eyebrow">Recently tended</p>
      <h2>Fresh from the garden</h2>
    </div>

    <div class="grid">
      {recent.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</Layout>

<style>
.hero {
  padding: 100px 0 140px;
  max-width: 720px;
}

.hero .eyebrow {
  color: var(--text);
  font-size: 14px;
  margin-bottom: 30px;
}

.hero h1 {
  font-family: var(--font-serif);
  font-size: clamp(52px, 9vw, 110px);
  line-height: 0.95;
  font-weight: 500;
  margin: 0 0 35px;
}

.intro {
  max-width: 560px;
  font-size: 22px;
  line-height: 1.6;
  margin-bottom: 40px;
}

.button {
  display: inline-block;
  background: var(--accent);
  color: white;
  padding: 14px 22px;
  border-radius: 4px;
  text-decoration: none;
  font-size: 15px;
  font-weight: 500;
}

.recent {
  padding: 80px 0;
  border-top: 1px solid var(--border);
}

.section-heading {
  margin-bottom: 40px;
}

.section-heading h2 {
  font-family: var(--font-serif);
  font-size: 48px;
  font-weight: 500;
  margin: 0;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 24px;
}

@media (max-width: 700px) {
  .hero {
    padding: 70px 0 100px;
  }

  .intro {
    font-size: 19px;
  }

  .recent {
    padding: 60px 0;
  }

  .section-heading h2 {
    font-size: 38px;
  }
}
</style>
