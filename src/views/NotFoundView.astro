---
import Layout from "../layouts/Layout.astro";
import PostCard from "../components/PostCard.astro";
import { getAllPosts } from "../lib/posts";
import { useTranslations, prefixOf, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const prefix = prefixOf(lang);
const recent = (await getAllPosts(lang)).slice(0, 3);

const copy = {
  en: {
    eyebrow: "404 · Page not found",
    title: ["This page hasn’t", "sprouted yet."],
    intro: "It may have moved, or it was never planted. Try the garden, or one of the latest bites below.",
    garden: "Go to the garden →",
    home: "Back to home",
  },
  ar: {
    eyebrow: "٤٠٤ · الصفحة غير موجودة",
    title: ["هذه الصفحة", "لم تنبت بعد."],
    intro: "ربما نُقلت، أو لم تُزرع أصلاً. جرّب الحديقة، أو واحدة من أحدث البايتس بالأسفل.",
    garden: "اذهب إلى الحديقة ←",
    home: "العودة للرئيسية",
  },
}[lang];
---

<Layout title={`404 — ${t.brand}`} lang={lang}>
  <section class="lost">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1>
      {copy.title[0]}<br />
      <mark>{copy.title[1]}</mark>
    </h1>
    <p class="intro">{copy.intro}</p>

    <div class="actions">
      <a class="button" href={`${prefix}/garden`}>{copy.garden}</a>
      <a class="back-link" href={prefix || "/"}>{copy.home}</a>
    </div>
  </section>

  {recent.length > 0 && (
    <div class="grid">
      {recent.map((post) => <PostCard post={post} pageLang={lang} />)}
    </div>
  )}
</Layout>

<style>
.lost {
  padding: 90px 0 70px;
  max-width: 720px;
}

h1 {
  font-family: var(--font-serif);
  font-size: clamp(46px, 7vw, 84px);
  line-height: 1;
  font-weight: 500;
  margin: 25px 0 30px;
}

:global([lang="ar"]) h1 {
  font-family: "Aref Ruqaa", var(--font-serif);
  font-weight: 700;
  line-height: 1.3;
}

mark {
  color: inherit;
  background: linear-gradient(to top, rgba(232, 117, 50, 0.28) 0 38%, transparent 38%);
  padding-inline: 0.08em;
}

.intro {
  max-width: 540px;
  font-size: 20px;
  line-height: 1.7;
  color: var(--text-muted);
}

.actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 24px;
  margin-top: 35px;
}

.button {
  display: inline-block;
  background: var(--accent);
  color: white;
  padding: 14px 22px;
  border-radius: 4px;
  text-decoration: none;
  font-size: 15px;
  font-weight: 500;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 24px;
  padding: 50px 0 120px;
  border-top: 1px solid var(--border);
}
</style>
